sudo pacman -S --needed git base-devel && \
if ! command -v paru >/dev/null 2>&1; then \
  tmp="$(mktemp -d)" && \
  git clone https://aur.archlinux.org/paru.git "$tmp/paru" && \
  (cd "$tmp/paru" && makepkg -si --noconfirm) && \
  rm -rf "$tmp"; \
fi && \
paru -S --needed --noconfirm \
  7zip bat bind btop duf eza fastfetch flatpak fzf gdu github-cli glow go \
  iperf3 kate kitty lazygit less lua51 luarocks neovim net-tools nfs-utils npm \
  openssh pacman-contrib pkgfile ripgrep rsync smartmontools snapper superfile \
  tealdeer tmux trash-cli tree tree-sitter-cli ttf-firacode-nerd \
  ttf-jetbrains-mono-nerd ufw unrar unzip vim wget wl-clipboard xdg-utils yadm \
  yay-bin yazi zoxide zsh
