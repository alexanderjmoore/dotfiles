#!/usr/bin/env bash

set -euo pipefail

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------

info() {
  printf '\n\033[1;34m==>\033[0m %s\n' "$1"
}

warn() {
  printf '\n\033[1;33m==>\033[0m %s\n' "$1"
}

die() {
  printf '\n\033[1;31merror:\033[0m %s\n' "$1" >&2
  exit 1
}

clone_if_missing() {
  local repo="$1"
  local destination="$2"

  if [[ -d "$destination" ]]; then
    printf '    exists: %s\n' "$destination"
    return
  fi

  git clone --depth=1 "$repo" "$destination"
}

# -----------------------------------------------------------------------------
# Sanity checks
# -----------------------------------------------------------------------------

command -v pacman >/dev/null 2>&1 || die "This bootstrap is intended for Arch-based distributions."

if [[ $EUID -eq 0 ]]; then
  die "Run this script as your normal user, not as root."
fi

# Get sudo credentials up front instead of interrupting us later.
sudo -v

# -----------------------------------------------------------------------------
# Base tooling
# -----------------------------------------------------------------------------

info "Installing base build tools"

sudo pacman -S --needed --noconfirm \
  base-devel \
  git

# -----------------------------------------------------------------------------
# AUR helper
# -----------------------------------------------------------------------------

if ! command -v paru >/dev/null 2>&1; then
  info "Bootstrapping paru"

  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' EXIT

  git clone https://aur.archlinux.org/paru.git "$tmpdir/paru"

  (
    cd "$tmpdir/paru"
    makepkg -si --needed --noconfirm
  )

  rm -rf "$tmpdir"
  trap - EXIT
else
  info "paru already installed"
fi

# -----------------------------------------------------------------------------
# Packages
#
# Keep this list distro-neutral within the Arch ecosystem.
#
# Do NOT put things here that depend strongly on the machine:
#   - NVIDIA / AMD drivers
#   - kernel packages
#   - bootloaders
#   - Plasma / Hyprland / desktop environments
#   - Snapper / Btrfs configuration
#   - CachyOS-specific packages
# -----------------------------------------------------------------------------

packages=(
  # Shell / terminal
  zsh
  tmux
  kitty

  # Shell utilities
  bat
  btop
  duf
  eza
  fastfetch
  fzf
  gdu
  glow
  less
  ripgrep
  superfile
  tealdeer
  trash-cli
  tree
  yazi
  zoxide

  # Editors
  neovim
  vim
  kate
  ghostwriter
  zed

  # Development
  github-cli
  go
  lua51
  luarocks
  npm
  python
  tree-sitter-cli
  uv

  # Networking / administration
  bind
  iperf3
  net-tools
  nfs-utils
  openssh
  rsync
  smartmontools
  ufw

  # Arch tooling
  pacman-contrib
  pkgfile
  yadm
  yay-bin

  # Desktop integration
  flatpak
  wl-clipboard
  xdg-utils

  # Archives / general utilities
  7zip
  unrar
  unzip
  wget

  # Fonts
  ttf-firacode-nerd
  ttf-jetbrains-mono-nerd
)

info "Installing packages"

paru -S --needed --noconfirm "${packages[@]}"

# -----------------------------------------------------------------------------
# Oh My Zsh
#
# These are cloned rather than tracked by yadm. This leaves each upstream
# project as a real Git repository that can be updated normally.
# -----------------------------------------------------------------------------

info "Installing shell framework"

clone_if_missing \
  "https://github.com/ohmyzsh/ohmyzsh.git" \
  "$HOME/.oh-my-zsh"

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

mkdir -p \
  "$ZSH_CUSTOM/plugins" \
  "$ZSH_CUSTOM/themes"

info "Installing Powerlevel10k"

clone_if_missing \
  "https://github.com/romkatv/powerlevel10k.git" \
  "$ZSH_CUSTOM/themes/powerlevel10k"

info "Installing zsh-autosuggestions"

clone_if_missing \
  "https://github.com/zsh-users/zsh-autosuggestions.git" \
  "$ZSH_CUSTOM/plugins/zsh-autosuggestions"

info "Installing zsh-syntax-highlighting"

clone_if_missing \
  "https://github.com/zsh-users/zsh-syntax-highlighting.git" \
  "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"

# -----------------------------------------------------------------------------
# Yazi
#
# package.toml should be tracked by yadm. The packages themselves should not.
# -----------------------------------------------------------------------------

if [[ -f "$HOME/.config/yazi/package.toml" ]]; then
  info "Installing Yazi packages"
  ya pkg install
else
  warn "No ~/.config/yazi/package.toml found; skipping Yazi package installation"
fi

# -----------------------------------------------------------------------------
# pkgfile
# -----------------------------------------------------------------------------

if command -v pkgfile >/dev/null 2>&1; then
  info "Updating pkgfile database"
  sudo pkgfile --update
fi

# -----------------------------------------------------------------------------
# Default shell
# -----------------------------------------------------------------------------

zsh_path="$(command -v zsh)"

if [[ "${SHELL:-}" != "$zsh_path" ]]; then
  warn "Your login shell is currently ${SHELL:-unknown}"
  printf '    To switch it to Zsh, run:\n\n'
  printf '        chsh -s %q\n\n' "$zsh_path"
fi

# -----------------------------------------------------------------------------
# Done
# -----------------------------------------------------------------------------

info "Bootstrap complete"

printf '\n'
printf 'Remaining machine-specific setup may include:\n'
printf '  - GPU drivers\n'
printf '  - desktop environment / window manager\n'
printf '  - filesystem and snapshot configuration\n'
printf '  - EasyEffects plugins/presets\n'
printf '  - application-specific authentication\n'
printf '\n'
